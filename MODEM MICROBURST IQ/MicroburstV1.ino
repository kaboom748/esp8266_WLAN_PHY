        !finite_f(p.min_symbol_margin) || p.min_symbol_margin < 0 || p.min_symbol_margin > 1 ||
        (p.kernel != MatchKernel::FixedQ15 && p.kernel != MatchKernel::FloatReference) ||
        p.coarse_step < 1 || p.coarse_step > 16) return Status::Invalid;
    const unsigned lag = p.samples_per_symbol / 4;
    if (p.max_cfo_error_hz >= p.sample_rate_hz / (2.0f * lag)) return Status::Invalid;
    for (unsigned j = 0; j < p.order; ++j) {
        if (!finite_f(p.tones_hz[j]) || fabsf(p.tones_hz[j] + p.cfo_hint_hz) + p.max_cfo_error_hz >= p.sample_rate_hz * 0.5f) return Status::Invalid;
        for (unsigned k = 0; k < j; ++k) if (fabsf(p.tones_hz[j] - p.tones_hz[k]) < p.sample_rate_hz / (8.0f * p.samples_per_symbol)) return Status::Invalid;
    }
    return Status::Ok;
}
size_t burst_sample_count(const Profile& p, size_t data_symbols) {
    return validate_profile(p) == Status::Ok && data_symbols <= kMaxDataSymbols ? (p.pilot_symbols + data_symbols) * p.samples_per_symbol : 0;
}
struct Match { float real, imag, power, energy; };
struct Oscillator { float c, s; int32_t cq, sq; };
static Oscillator oscillator(float freq, float fs) {
    const float angle = -kTwoPi * freq / fs;
    Oscillator o; o.c = cosf(angle); o.s = sinf(angle);
    o.cq = int32_t(lroundf(o.c * 32767.0f)); o.sq = int32_t(lroundf(o.s * 32767.0f));
    return o;
}
static void reject_constant(Match& m, unsigned n, float sum_i, float sum_q, float sum_wr, float sum_wi) {
    const float inv_n = 1.0f / float(n);
    const float mean_i = sum_i * inv_n, mean_q = sum_q * inv_n;
    m.real -= mean_i * sum_wr - mean_q * sum_wi;
    m.imag -= mean_i * sum_wi + mean_q * sum_wr;
    m.energy -= (sum_i * sum_i + sum_q * sum_q) * inv_n;
    if (m.energy < 0) m.energy = 0;
    const float gain = 1.0f - (sum_wr * sum_wr + sum_wi * sum_wi) * inv_n * inv_n;
    // Projection onto a tone orthogonalized against the constant nuisance.
    // Normalize its energy; simply subtracting a mean biases non-bin tones.
    m.power = gain > 0.0001f ? (m.real * m.real + m.imag * m.imag) / gain : 0;
}
static Match matched_float(const volatile uint32_t* x, unsigned n, const Oscillator& o, bool reject_dc) {
    const float c = o.c, s = o.s;
    float wr = 1, wi = 0, sum_i = 0, sum_q = 0, sum_wr = 0, sum_wi = 0; Match m = {};
    for (unsigned k = 0; k < n; ++k) {
        IQ z = unpack_iq(x[k]); m.real += z.i * wr - z.q * wi; m.imag += z.i * wi + z.q * wr;
        m.energy += z.i * z.i + z.q * z.q;
        if (reject_dc) { sum_i += z.i; sum_q += z.q; sum_wr += wr; sum_wi += wi; }
        float nr = wr * c - wi * s; wi = wi * c + wr * s; wr = nr;
    }
    m.power = m.real * m.real + m.imag * m.imag;
    if (reject_dc) reject_constant(m, n, sum_i, sum_q, sum_wr, sum_wi);
    return m;
}
static int32_t rounded_q15(int32_t x) {
    return x >= 0 ? (x + 16384) / 32768 : -((-x + 16384) / 32768);
}
static Match matched_fixed(const volatile uint32_t* x, unsigned n, const Oscillator& o, bool reject_dc) {
    const int32_t c = o.cq, s = o.sq;
    int32_t wr = 32767, wi = 0, r = 0, im = 0;
    int32_t sum_i = 0, sum_q = 0, sum_wr = 0, sum_wi = 0;
    uint32_t energy = 0;
    // N<=256, signed10 IQ: oscillator products stay below 2^31;
    // mixed sums /256 stay below 2^25 and energy below 2^28.
    // No floating multiply occurs in this per-sample loop.
    for (unsigned k = 0; k < n; ++k) {
        const uint32_t word = x[k];
        const int32_t a = signed10(word), b = -signed10(word >> 10);
        r += (a * wr - b * wi) / 256;
        im += (a * wi + b * wr) / 256;
        energy += uint32_t(a * a + b * b);
        if (reject_dc) { sum_i += a; sum_q += b; sum_wr += wr; sum_wi += wi; }
        const int32_t nr = rounded_q15(wr * c - wi * s);
        wi = rounded_q15(wi * c + wr * s); wr = nr;
    }
    Match m;
    m.real = float(r) / 128.0f; m.imag = float(im) / 128.0f;
    m.energy = float(energy); m.power = m.real * m.real + m.imag * m.imag;
    if (reject_dc) reject_constant(m, n, float(sum_i), float(sum_q), float(sum_wr) / 32768.0f, float(sum_wi) / 32768.0f);
    return m;
}
static Match matched(const volatile uint32_t* x, unsigned n, const Oscillator& o, const Profile& p) {
    return p.kernel == MatchKernel::FixedQ15 ? matched_fixed(x, n, o, p.reject_dc) : matched_float(x, n, o, p.reject_dc);
}
struct CfoContext { unsigned lag; float expected_phase, hz_per_radian; };
static CfoContext cfo_context(const Profile& p) {
    CfoContext c; c.lag = p.samples_per_symbol / 4;
    c.expected_phase = remainderf(kTwoPi * (p.tones_hz[0] + p.cfo_hint_hz) * c.lag / p.sample_rate_hz, kTwoPi);
    c.hz_per_radian = p.sample_rate_hz / (kTwoPi * c.lag);
    return c;
}
static float estimate_cfo(const volatile uint32_t* x, const Profile& p, const CfoContext& context) {
    const unsigned n = p.samples_per_symbol, lag = context.lag, pairs = n - lag;
    int32_t r = 0, im = 0, sum_ar = 0, sum_ai = 0, sum_br = 0, sum_bi = 0;
    for (unsigned k = 0; k < pairs; ++k) {
        const uint32_t wa = x[k], wb = x[k + lag];
        const int32_t ar = signed10(wa), ai = -signed10(wa >> 10);
        const int32_t br = signed10(wb), bi = -signed10(wb >> 10);
        r += ar * br + ai * bi; im += ar * bi - ai * br;
        sum_ar += ar; sum_ai += ai; sum_br += br; sum_bi += bi;
    }
    // Center EACH paired window independently. For a pure complex tone this
    // covariance has the exact lag phase, even with arbitrary constant IQ DC.
    // N<=256: per-loop sums fit int32; cast BEFORE the final products.
    const int64_t real = int64_t(pairs) * r - int64_t(sum_ar) * sum_br - int64_t(sum_ai) * sum_bi;
    const int64_t imag = int64_t(pairs) * im - int64_t(sum_ar) * sum_bi + int64_t(sum_ai) * sum_br;
    if (real == 0 && imag == 0) return p.cfo_hint_hz;
    float delta = atan2f(float(imag), float(real)) - context.expected_phase;
    if (delta > kPi) delta -= kTwoPi;
    else if (delta < -kPi) delta += kTwoPi;
    return p.cfo_hint_hz + delta * context.hz_per_radian;
}
struct Candidate {
    float score = -1, cfo = 0, real = 0, imag = 0;
    size_t start = 0;
    unsigned repeat_index = 0, header_errors = 0;
};
static Candidate pilot_at_cfo(const volatile uint32_t* x, const Profile& p, size_t start, float cfo) {
    Candidate candidate; candidate.start = start;
    candidate.cfo = cfo;
    // Only two pilot tones: prepare their steps once per candidate, not per pilot.
    const Oscillator osc[2] = {oscillator(p.tones_hz[0] + candidate.cfo, p.sample_rate_hz),
                              oscillator(p.tones_hz[p.order - 1] + candidate.cfo, p.sample_rate_hz)};
    float group[2] = {}; unsigned group_count[2] = {};
    for (unsigned j = 0; j < p.pilot_symbols; ++j) {
        Match m = matched(x + start + j * p.samples_per_symbol, p.samples_per_symbol, osc[j & 1], p);
        group[j & 1] += m.energy > 0 ? m.power / (float(p.samples_per_symbol) * m.energy) : 0;
        ++group_count[j & 1];
        if (j == 0) { candidate.real = m.real; candidate.imag = m.imag; }
    }
    // Both tone groups must carry the pilot. A single continuous tone cannot
    // pass by averaging its strong group with an absent opposite-tone group.
    // This uses the same number of matched filters as the original mean score.
    const float first = group[0] / group_count[0], second = group[1] / group_count[1];
    candidate.score = first < second ? first : second;
    return candidate;
}
static Candidate pilot_candidate(const volatile uint32_t* x, const Profile& p, const CfoContext& context, size_t start, bool use_hint = false) {
    if (use_hint) return pilot_at_cfo(x, p, start, p.cfo_hint_hz);
    // A short first pilot can give a biased CFO under another RF tone. Never
    // discard the independently supplied CFO hint because that estimate fails.
    const float estimated = estimate_cfo(x + start, p, context);
    const float selected = finite_f(estimated) && fabsf(estimated - p.cfo_hint_hz) <= p.max_cfo_error_hz
        ? estimated : p.cfo_hint_hz;
    return pilot_at_cfo(x, p, start, selected);
}
static Candidate repeated_pilot_candidate(const volatile uint32_t* x, const Profile& p,
                                          const CfoContext& context, size_t start,
                                          bool use_hint = false) {
    Candidate candidate;
    candidate.start = start;
    float cfo = p.cfo_hint_hz;
    if (!use_hint) {
        const float estimated = estimate_cfo(x + start, p, context);
        if (finite_f(estimated) && fabsf(estimated - p.cfo_hint_hz) <= p.max_cfo_error_hz)
            cfo = estimated;
    }
    candidate.cfo = cfo;
    const Oscillator osc[2] = {oscillator(p.tones_hz[0] + cfo, p.sample_rate_hz),
                              oscillator(p.tones_hz[p.order - 1] + cfo, p.sample_rate_hz)};
    static const uint8_t marker[6] = {0, 1, 0, 0, 1, 1};
    float group[2] = {};
    for (unsigned j = 0; j < 6; ++j) {
        const Match m = matched(x + start + j * p.samples_per_symbol,
                                p.samples_per_symbol, osc[marker[j]], p);
        group[marker[j]] += m.energy > 0
            ? m.power / (float(p.samples_per_symbol) * m.energy) : 0;
        if (j == 0) { candidate.real = m.real; candidate.imag = m.imag; }
    }
    candidate.score = (group[0] < group[1] ? group[0] : group[1]) / 3.0f;
    return candidate;
}
class TimingSearch {
public:
    TimingSearch(const volatile uint32_t* x, const Profile& p, size_t lo, size_t hi,
                  bool repeated = false)
        : x_(x), p_(p), lo_(lo), hi_(hi), visits_(0), coarse_visits_(0),
          context_(cfo_context(p)), repeated_(repeated) { memset(visited_, 0, sizeof visited_); best.start = lo; }
    Candidate coarse(size_t start) {
        ++coarse_visits_;
        // CFO estimation across a displaced pilot boundary is unreliable. Rank
        // coarse windows at the independently supplied CFO hint, then estimate
        // the CFO only when refining their individual sample positions.
        return repeated_ ? repeated_pilot_candidate(x_, p_, context_, start, true)
                         : pilot_candidate(x_, p_, context_, start, true);
    }
    Candidate evaluate(size_t start) {
        const size_t index = start - lo_;
        Candidate c; c.start = start;
        if (visited_[index / 32] & (1U << (index % 32))) return c;
        visited_[index / 32] |= 1U << (index % 32); ++visits_;
        c = repeated_ ? repeated_pilot_candidate(x_, p_, context_, start)
                      : pilot_candidate(x_, p_, context_, start);
        if (c.score > best.score || (c.score == best.score && c.start < best.start)) best = c;
        return c;
    }
    void exhaustive() { for (size_t start = lo_; start <= hi_; ++start) evaluate(start); }
    bool complete() const { return visits_ == hi_ - lo_ + 1; }
    unsigned visits() const { return visits_ + coarse_visits_; }
    Candidate best;
private:
    const volatile uint32_t* x_;
    const Profile& p_;
    size_t lo_, hi_;
    unsigned visits_, coarse_visits_;
    CfoContext context_;
    bool repeated_;
    // The repeated-train search can inspect pilot starts beyond the original
    // 1024-sample contiguous-frame timing span, but never beyond this capture.
    uint32_t visited_[(kMaxSamples + 31) / 32];
};
static void retain_candidate(const Candidate& candidate, Candidate* top) {
    if (candidate.score < 0) return;
    for (unsigned j = 0; j < 4; ++j) {
        if (candidate.score > top[j].score) {
            for (unsigned k = 3; k > j; --k) top[k] = top[k - 1];
            top[j] = candidate; return;
        }
    }
}
static void slice_data(const volatile uint32_t* x, const Profile& p, size_t count,
                       uint8_t* out, const Candidate& best, BurstResult& result) {
    Oscillator tones[8];
    for (unsigned tone = 0; tone < p.order; ++tone){
        tones[tone] = oscillator(p.tones_hz[tone] + best.cfo, p.sample_rate_hz);
    }
    float minimum = 1, total_margin = 0;
    for (size_t j = 0; j < count; ++j) {
        float first = -1, second = -1; unsigned winner = 0;
        for (unsigned tone = 0; tone < p.order; ++tone) {
            Match m = matched(x + best.start + (p.pilot_symbols + j) * p.samples_per_symbol,
                              p.samples_per_symbol, tones[tone], p);
            if (m.power > first) { second = first; first = m.power; winner = tone; }
            else if (m.power > second) second = m.power;
        }
        const float margin = first > 0 ? (first - second) / first : 0;
        if (margin < minimum) minimum = margin;
        total_margin += margin; out[j] = uint8_t(winner);
    }
    result.data_symbols = count; result.min_margin = minimum; result.mean_margin = total_margin / float(count);
}
Status decode_burst(const volatile uint32_t* x, size_t count, const Profile& p, size_t lo, size_t hi,
                    size_t data_count, uint8_t* out, size_t cap, BurstResult& result) {
    result = BurstResult();
    if (!x || !out || validate_profile(p) != Status::Ok || count > kMaxSamples || lo > hi ||
        hi - lo > kMaxTimingSpan || data_count == 0 || data_count > kMaxDataSymbols) return Status::Invalid;
    const size_t needed = burst_sample_count(p, data_count);
    if (cap < data_count || hi > count || needed > count - hi) return Status::Capacity;
    TimingSearch search(x, p, lo, hi);
    if (p.coarse_step == 1) search.exhaustive();
    else {
        Candidate top[4];
        const unsigned step = p.coarse_step < p.samples_per_symbol / 4 ? p.coarse_step : p.samples_per_symbol / 4;
        for (size_t start = lo; start <= hi; start += step) retain_candidate(search.coarse(start), top);
        if ((hi - lo) % step) retain_candidate(search.coarse(hi), top);
        const size_t radius = step - 1;
        for (unsigned j = 0; j < 4; ++j) {
            if (top[j].score < 0) continue;
            const size_t first = top[j].start - lo > radius ? top[j].start - radius : lo;
            const size_t last = hi - top[j].start > radius ? top[j].start + radius : hi;
            for (size_t start = first; start <= last; ++start) search.evaluate(start);
        }
    }
    // Weak acquisition or symbol confidence gets the exhaustive reference path.
    // No candidate is evaluated twice, even where refinement regions overlap.
    for (unsigned pass = 0; pass < 2; ++pass) {
        result.start_sample = search.best.start; result.cfo_hz = search.best.cfo;
        result.phase_rad = atan2f(search.best.imag, search.best.real);
        result.pilot_coherence = search.best.score; result.search_candidates = search.visits();
        if (search.best.score >= p.min_pilot_coherence) {
            slice_data(x, p, data_count, out, search.best, result);
            if (result.min_margin >= p.min_symbol_margin) return Status::Ok;
        }
        if (search.complete()) return Status::Sync;
        result.exhaustive_fallback = true; search.exhaustive();
    }
    return Status::Sync;
}
static bool decode_budget_allows(const Profile& p,DecodeStage stage) {
    return !p.decode_budget||p.decode_budget(stage,p.decode_budget_context);
}
static void slice_repeated_data(const volatile uint32_t* x, size_t samples,
                                const Profile& p, size_t count, uint8_t* out,
                                uint8_t* erased, const Candidate& best,
                                BurstResult& result,bool honor_budget=false) {
    const size_t period = burst_sample_count(p, count);
    const unsigned n = p.samples_per_symbol;
    Oscillator tones[8];
    for (unsigned tone = 0; tone < p.order; ++tone){
        if(honor_budget&&!decode_budget_allows(p,DecodeStage::Payload))return;
        tones[tone] = oscillator(p.tones_hz[tone] + best.cfo, p.sample_rate_hz);
    }
    float minimum = 1, total_margin = 0;
    for (size_t j = 0; j < count; ++j) {
        if(honor_budget&&!decode_budget_allows(p,DecodeStage::Payload))return;
        const size_t phase = (best.start + (p.pilot_symbols + j) * n) % period;
        float selected_margin = -1;
        unsigned selected_tone = 0;
        // More than one copy may be present. Prefer its most confident real
        // observation; do not synthesize samples across the capture boundary.
        for (size_t start = phase; start + n <= samples; start += period) {
            float first = -1, second = -1;
            unsigned winner = 0;
            for (unsigned tone = 0; tone < p.order; ++tone) {
                if(honor_budget&&!decode_budget_allows(p,DecodeStage::Payload))return;
                const Match m = matched(x + start, n, tones[tone], p);
                if (m.power > first) { second = first; first = m.power; winner = tone; }
                else if (m.power > second) second = m.power;
            }
            const float margin = first > 0 ? (first - second) / first : 0;
            if (margin > selected_margin) { selected_margin = margin; selected_tone = winner; }
        }
        // Validation guarantees at least one complete window at every phase.
        if (selected_margin < 0) selected_margin = 0;
        out[j] = uint8_t(selected_tone);
        erased[j] = uint8_t(selected_margin < p.min_symbol_margin);
        if (selected_margin < minimum) minimum = selected_margin;
        total_margin += selected_margin;
    }
    result.data_symbols = count;
    result.min_margin = minimum;
    result.mean_margin = total_margin / float(count);
}
Status decode_repeated_burst(const volatile uint32_t* x, size_t count, const Profile& p,
                             size_t data_count, uint8_t* out, uint8_t* erased,
                             size_t cap, BurstResult& result) {
    result = BurstResult();
    if (!x || !out || !erased || validate_profile(p) != Status::Ok || p.pilot_symbols != 6 ||
        count > kMaxSamples || data_count == 0 || data_count > kMaxDataSymbols)
        return Status::Invalid;
    const size_t period = burst_sample_count(p, data_count);
    const size_t pilots = p.pilot_symbols * p.samples_per_symbol;
    if (cap < data_count || !period || count < period + p.samples_per_symbol - 1)
        return Status::Capacity;
    const size_t hi = count - pilots;
    TimingSearch search(x, p, 0, hi, true);
    if (p.coarse_step == 1) search.exhaustive();
    else {
        Candidate top[4];
        const unsigned step = p.coarse_step < p.samples_per_symbol / 4
            ? p.coarse_step : p.samples_per_symbol / 4;
        for (size_t start = 0; start <= hi; start += step)
            retain_candidate(search.coarse(start), top);
        if (hi % step) retain_candidate(search.coarse(hi), top);
        const size_t radius = step - 1;
        for (unsigned j = 0; j < 4; ++j) {
            if (top[j].score < 0) continue;
            const size_t first = top[j].start > radius ? top[j].start - radius : 0;
            const size_t last = hi - top[j].start > radius ? top[j].start + radius : hi;
            for (size_t start = first; start <= last; ++start) search.evaluate(start);
        }
    }
    // A weak pilot still gets the exhaustive reference search. Low data
    // margins become erasures instead of discarding an otherwise useful block.
    for (unsigned pass = 0; pass < 2; ++pass) {
        result.start_sample = search.best.start;
        result.cfo_hz = search.best.cfo;
        result.phase_rad = atan2f(search.best.imag, search.best.real);
        result.pilot_coherence = search.best.score;
        result.search_candidates = search.visits();
        if (search.best.score >= p.min_pilot_coherence) {
            slice_repeated_data(x, count, p, data_count, out, erased, search.best, result);
            return Status::Ok;
        }
        if (search.complete()) return Status::Sync;
        result.exhaustive_fallback = true;
        search.exhaustive();
    }
    return Status::Sync;
}
// Indexed geometry is70DATA+7header tones and <=2048IQ; its capacity check
// therefore limits samples_per_symbol to26. Cache the EXACT same Q15 phasor
// recurrence as matched_fixed rather than recomputing it per input window.
// BSS only,1664bytes plus a48byte exact owner key,no initialization/heap/IRAM.
// Like the RS decoder and the
// firmware's BANK0 input, indexed decoding is foreground-only/non-reentrant.
static const unsigned kIndexedPhaseSamples=26;
struct IndexedPhaseBank {
    int32_t real[8][kIndexedPhaseSamples],imag[8][kIndexedPhaseSamples];
};
static IndexedPhaseBank indexedPhaseBank;
struct IndexedPhaseKey {
    float sample_rate,cfo,tones[8];unsigned samples;bool valid;
};
static IndexedPhaseKey indexedPhaseKey;
static bool indexed_phase_key_matches(const Profile& p,float cfo) {
    if(!indexedPhaseKey.valid||indexedPhaseKey.samples!=p.samples_per_symbol||
       indexedPhaseKey.sample_rate!=p.sample_rate_hz||indexedPhaseKey.cfo!=cfo)return false;
    for(unsigned tone=0;tone<8;++tone)if(indexedPhaseKey.tones[tone]!=p.tones_hz[tone])return false;
    return true;
}
static void indexed_tag_phase_key(const Profile& p,float cfo) {
    indexedPhaseKey.sample_rate=p.sample_rate_hz;indexedPhaseKey.cfo=cfo;
    indexedPhaseKey.samples=p.samples_per_symbol;
    for(unsigned tone=0;tone<8;++tone)indexedPhaseKey.tones[tone]=p.tones_hz[tone];
    indexedPhaseKey.valid=true;
}
static void indexed_prepare_phases(const Oscillator* tones,unsigned n) {
    // This lower-level writer also serves coarse hint searches. Invalidate
    // before any write; only a completed bank with a known owner can be reused.
    indexedPhaseKey.valid=false;
    for(unsigned tone=0;tone<8;++tone){
        int32_t wr=32767,wi=0;
        const int32_t c=tones[tone].cq,s=tones[tone].sq;
        for(unsigned k=0;k<n;++k){
            indexedPhaseBank.real[tone][k]=wr;indexedPhaseBank.imag[tone][k]=wi;
            const int32_t nr=rounded_q15(wr*c-wi*s);
            wi=rounded_q15(wi*c+wr*s);wr=nr;
        }
    }
}
static Match indexed_matched_phase(const volatile uint32_t* x,unsigned n,unsigned tone,bool reject_dc) {
    int32_t r=0,im=0,sum_i=0,sum_q=0,sum_wr=0,sum_wi=0;uint32_t energy=0;
    for(unsigned k=0;k<n;++k){
        const uint32_t word=x[k];const int32_t a=signed10(word),b=-signed10(word>>10);
        const int32_t wr=indexedPhaseBank.real[tone][k],wi=indexedPhaseBank.imag[tone][k];
        r+=(a*wr-b*wi)/256;im+=(a*wi+b*wr)/256;energy+=uint32_t(a*a+b*b);
        if(reject_dc){sum_i+=a;sum_q+=b;sum_wr+=wr;sum_wi+=wi;}
    }
    Match m;m.real=float(r)/128.0f;m.imag=float(im)/128.0f;
    m.energy=float(energy);m.power=m.real*m.real+m.imag*m.imag;
    if(reject_dc)reject_constant(m,n,float(sum_i),float(sum_q),float(sum_wr)/32768.0f,float(sum_wi)/32768.0f);
    return m;
}
static void indexed_phase_powers(const volatile uint32_t* x,unsigned n,bool reject_dc,float powers[8]) {
    int32_t r[8]={},im[8]={},sum_wr[8]={},sum_wi[8]={};
    int32_t sum_i=0,sum_q=0;uint32_t energy=0;
    // Each tone retains precisely its original integer accumulation order,
    // truncation and Q15 recurrence. Only IQ unpacking and energy are shared.
    for(unsigned k=0;k<n;++k){
        const uint32_t word=x[k];const int32_t a=signed10(word),b=-signed10(word>>10);
        energy+=uint32_t(a*a+b*b);if(reject_dc){sum_i+=a;sum_q+=b;}
        for(unsigned tone=0;tone<8;++tone){
            const int32_t wr=indexedPhaseBank.real[tone][k],wi=indexedPhaseBank.imag[tone][k];
            r[tone]+=(a*wr-b*wi)/256;im[tone]+=(a*wi+b*wr)/256;
            if(reject_dc){sum_wr[tone]+=wr;sum_wi[tone]+=wi;}
        }
    }
    for(unsigned tone=0;tone<8;++tone){
        Match m;m.real=float(r[tone])/128.0f;m.imag=float(im[tone])/128.0f;
        m.energy=float(energy);m.power=m.real*m.real+m.imag*m.imag;
        if(reject_dc)reject_constant(m,n,float(sum_i),float(sum_q),float(sum_wr[tone])/32768.0f,float(sum_wi[tone])/32768.0f);
        powers[tone]=m.power;
    }
}
static bool slice_indexed_data(const volatile uint32_t* x,size_t samples,const Profile& p,size_t count,
                               uint8_t* out,uint8_t* erased,const Candidate& best,BurstResult& result) {
    if(!decode_budget_allows(p,DecodeStage::Payload))return false;
    if(p.kernel!=MatchKernel::FixedQ15||p.samples_per_symbol>kIndexedPhaseSamples){
        slice_repeated_data(x,samples,p,count,out,erased,best,result,true);return decode_budget_allows(p,DecodeStage::Payload);
    }
    const size_t period=burst_sample_count(p,count);const unsigned n=p.samples_per_symbol;
    const bool reuse=indexed_phase_key_matches(p,best.cfo);
    Oscillator tones[8];for(unsigned tone=0;tone<8;++tone){
        if(!decode_budget_allows(p,DecodeStage::Payload))return false;
        if(!reuse)tones[tone]=oscillator(p.tones_hz[tone]+best.cfo,p.sample_rate_hz);
    }
    if(!reuse){
        indexed_prepare_phases(tones,n);
        indexed_tag_phase_key(p,best.cfo);
    }
    float minimum=1,total_margin=0;
    for(size_t j=0;j<count;++j){
        if(!decode_budget_allows(p,DecodeStage::Payload))return false;
        const size_t phase=(best.start+(p.pilot_symbols+j)*n)%period;
        float selected_margin=-1;unsigned selected_tone=0;
        for(size_t start=phase;start+n<=samples;start+=period){
            float powers[8];indexed_phase_powers(x+start,n,p.reject_dc,powers);
            float first=-1,second=-1;unsigned winner=0;
            for(unsigned tone=0;tone<8;++tone){
                if(powers[tone]>first){second=first;first=powers[tone];winner=tone;}
                else if(powers[tone]>second)second=powers[tone];
            }
            const float margin=first>0?(first-second)/first:0;
            if(margin>selected_margin){selected_margin=margin;selected_tone=winner;}
        }
        if(selected_margin<0)selected_margin=0;
        out[j]=uint8_t(selected_tone);erased[j]=uint8_t(selected_margin<p.min_symbol_margin);
        if(selected_margin<minimum)minimum=selected_margin;
        total_margin+=selected_margin;
    }
    result.data_symbols=count;result.min_margin=minimum;result.mean_margin=total_margin/float(count);
    return decode_budget_allows(p,DecodeStage::Payload);
}
// A tone is also identified by the phase of its lagged autocovariance.
// Subtracting the two paired means removes a constant IQ leak without a
// sample-by-sample floating-point projection. Unlike the matched bank this
// needs one pass over N-lag pairs, then only eight integer dot products.
// The shorter lag stays unambiguous near the ADC band edges. Narrowly spaced
// profiles may have weak margins and simply take the original matched retry.
static bool slice_indexed_frequency(const volatile uint32_t* x,size_t samples,const Profile& p,size_t count,
                                    uint8_t* out,uint8_t* erased,const Candidate& best,BurstResult& result) {
    if(!decode_budget_allows(p,DecodeStage::Payload))return false;
    const unsigned n=p.samples_per_symbol;
    unsigned lag=2;
    for(unsigned tone=0;tone<8;++tone)
        if(fabsf(p.tones_hz[tone]+best.cfo)>=p.sample_rate_hz*0.225f)lag=1;
    int32_t direction_r[8],direction_i[8];
    const bool reuse=n<=kIndexedPhaseSamples&&indexed_phase_key_matches(p,best.cfo);
    for(unsigned tone=0;tone<8;++tone){
        if(!decode_budget_allows(p,DecodeStage::Payload))return false;
        if(reuse){
            direction_r[tone]=indexedPhaseBank.real[tone][lag];
            direction_i[tone]=-indexedPhaseBank.imag[tone][lag];
        }else{
            const Oscillator step=oscillator((p.tones_hz[tone]+best.cfo)*float(lag),p.sample_rate_hz);
            direction_r[tone]=step.cq;direction_i[tone]=-step.sq;
        }
    }
    const size_t period=burst_sample_count(p,count);
    const unsigned pairs=n-lag;
    float minimum=1,total_margin=0;
    for(size_t j=0;j<count;++j){
        if(!decode_budget_allows(p,DecodeStage::Payload))return false;
        const size_t phase=(best.start+(p.pilot_symbols+j)*n)%period;
        float selected_margin=-1;unsigned selected_tone=0;
        for(size_t start=phase;start+n<=samples;start+=period){
            int32_t r=0,im=0,sum_ar=0,sum_ai=0,sum_br=0,sum_bi=0;
            uint32_t energy_a=0,energy_b=0;
            for(unsigned k=0;k<pairs;++k){
                const uint32_t aw=x[start+k],bw=x[start+k+lag];
                const int32_t ar=signed10(aw),ai=-signed10(aw>>10);
                const int32_t br=signed10(bw),bi=-signed10(bw>>10);
                r+=ar*br+ai*bi;im+=ar*bi-ai*br;
                sum_ar+=ar;sum_ai+=ai;sum_br+=br;sum_bi+=bi;
                energy_a+=uint32_t(ar*ar+ai*ai);energy_b+=uint32_t(br*br+bi*bi);
            }
            const int64_t real=int64_t(pairs)*r-int64_t(sum_ar)*sum_br-int64_t(sum_ai)*sum_bi;
            const int64_t imag=int64_t(pairs)*im-int64_t(sum_ar)*sum_bi+int64_t(sum_ai)*sum_br;
            const int64_t variance_a=int64_t(pairs)*energy_a-int64_t(sum_ar)*sum_ar-int64_t(sum_ai)*sum_ai;
            const int64_t variance_b=int64_t(pairs)*energy_b-int64_t(sum_br)*sum_br-int64_t(sum_bi)*sum_bi;
            float margin=0;unsigned winner=0;
            if(variance_a>0&&variance_b>0&&(real||imag)){
                int64_t scaled_r=real,scaled_i=imag;
                while(scaled_r>32767||scaled_r<-32767||scaled_i>32767||scaled_i<-32767){scaled_r/=2;scaled_i/=2;}
                const int32_t vr=int32_t(scaled_r),vi=int32_t(scaled_i);
                int64_t first=INT64_MIN,second=INT64_MIN;
                for(unsigned tone=0;tone<8;++tone){
                    const int64_t projection=int64_t(vr)*direction_r[tone]+int64_t(vi)*direction_i[tone];
                    if(projection>first){second=first;first=projection;winner=tone;}
                    else if(projection>second)second=projection;
                }
                const float fr=float(real),fi=float(imag);
                float coherence=(fr*fr+fi*fi)/(float(variance_a)*float(variance_b));
                if(coherence>1)coherence=1;
                if(first>0&&coherence>=p.min_pilot_coherence)
                    margin=float(first-second)/float(first)*coherence;
            }
            if(margin>selected_margin){selected_margin=margin;selected_tone=winner;}
        }
        if(selected_margin<0)selected_margin=0;
        out[j]=uint8_t(selected_tone);erased[j]=uint8_t(selected_margin<p.min_symbol_margin);
        if(selected_margin<minimum)minimum=selected_margin;
        total_margin+=selected_margin;
    }
    result.data_symbols=count;result.min_margin=minimum;result.mean_margin=total_margin/float(count);
    return decode_budget_allows(p,DecodeStage::Payload);
}
static Candidate indexed_candidate(const volatile uint32_t* x,const Profile& p,
                                    const CfoContext& context,size_t start,bool use_hint,
                                    const Oscillator* cached_hint=nullptr,bool decode_header=true,DecodeStage stage=DecodeStage::Search,
                                    bool* hard_aborted=nullptr,bool* completed=nullptr) {
    Candidate candidate; candidate.start = start;
    if(completed)*completed=false;
    if(!decode_budget_allows(p,stage)){if(stage==DecodeStage::Payload&&hard_aborted)*hard_aborted=true;return candidate;}
    float cfo = p.cfo_hint_hz;
    if (!use_hint) {
        const float estimated = estimate_cfo(x + start,p,context);
        if (finite_f(estimated) && fabsf(estimated - p.cfo_hint_hz) <= p.max_cfo_error_hz) cfo = estimated;
    }
    candidate.cfo = cfo;
    // Coarse positions all use the same hint. Their oscillator steps are
    // immutable, so the search computes those eight values once. Refined
    // positions retain their independently estimated CFO and prepare only
    // two endpoints before the weak-marker early exit.
    const Oscillator* cached=use_hint?cached_hint:nullptr;
    const bool phase_kernel=p.kernel==MatchKernel::FixedQ15&&p.samples_per_symbol<=kIndexedPhaseSamples;
    Oscillator endpoints[2];
    if(!cached){
        endpoints[0]=oscillator(p.tones_hz[0]+cfo,p.sample_rate_hz);
        if(!decode_budget_allows(p,stage)){if(stage==DecodeStage::Payload&&hard_aborted)*hard_aborted=true;return candidate;}
        endpoints[1]=oscillator(p.tones_hz[7]+cfo,p.sample_rate_hz);
    }
    float group[2] = {};
    for (unsigned j = 0;j < 3;++j) {
        if(!decode_budget_allows(p,stage)){if(stage==DecodeStage::Payload&&hard_aborted)*hard_aborted=true;return candidate;}
        const unsigned end = indexed::marker(j) ? 1u : 0u;
        const Oscillator& endpoint=cached?cached[end?7:0]:endpoints[end];
        const Match m = cached&&phase_kernel
            ?indexed_matched_phase(x+start+j*p.samples_per_symbol,p.samples_per_symbol,end?7u:0u,p.reject_dc)
            :matched(x+start+j*p.samples_per_symbol,p.samples_per_symbol,endpoint,p);
        group[end] += m.energy > 0 ? m.power/(float(p.samples_per_symbol)*m.energy) : 0;
        if (!j) { candidate.real = m.real; candidate.imag = m.imag; }
    }
    const float first = group[0]/2.0f;
    const float score = first < group[1] ? first : group[1];
    // Avoid slicing all eight tones for clearly absent markers. Refined
    // searches estimate CFO first, so acquisition does not depend on a known
    // per-board CFO hint; a weak coarse search has the exhaustive fallback.
    if (score < p.min_pilot_coherence*0.7f) {if(completed)*completed=true;return candidate;}
    if(!decode_header){candidate.score=score;if(completed)*completed=true;return candidate;}
    const DecodeStage header_stage=stage==DecodeStage::Search?DecodeStage::Payload:stage;
    Oscillator tones[8];
    const Oscillator* steps=cached;
    if(!steps){
        for(unsigned tone=0;tone<8;++tone){
            if(!decode_budget_allows(p,header_stage)){if(hard_aborted)*hard_aborted=true;return candidate;}
            // These two oscillator values were already computed above with
            // exactly the same arguments. Reuse their exact Q15/float values.
            tones[tone]=tone==0?endpoints[0]:tone==7?endpoints[1]:
                oscillator(p.tones_hz[tone]+cfo,p.sample_rate_hz);
        }
        steps=tones;
    }
    if(phase_kernel&&!cached){
        indexed_prepare_phases(steps,p.samples_per_symbol);
        // The immediately following payload uses these same exact Q15 phases.
        indexed_tag_phase_key(p,cfo);
    }
    uint8_t header[4];
    for (unsigned j = 0;j < 4;++j) {
        if(!decode_budget_allows(p,header_stage)){if(hard_aborted)*hard_aborted=true;return candidate;}
        float first_power = -1,second_power = -1; unsigned winner = 0;
        float powers[8];
        if(phase_kernel)indexed_phase_powers(x+start+(3+j)*p.samples_per_symbol,p.samples_per_symbol,p.reject_dc,powers);
        for (unsigned tone = 0;tone < 8;++tone) {
            const float power=phase_kernel?powers[tone]:matched(x+start+(3+j)*p.samples_per_symbol,p.samples_per_symbol,steps[tone],p).power;
            if (power > first_power) { second_power=first_power;first_power=power;winner=tone; }
            else if (power > second_power) second_power=power;
        }
        const float margin=first_power>0?(first_power-second_power)/first_power:0;
        const float required=p.min_symbol_margin>0.1f?p.min_symbol_margin:0.1f;
        if (margin<required) {if(completed)*completed=true;return candidate;}
        header[j]=uint8_t(winner);
    }
    if (!indexed::decode(header,candidate.repeat_index,candidate.header_errors)) {if(completed)*completed=true;return candidate;}
    candidate.score=score;if(completed)*completed=true;return candidate;
}
static bool indexed_better(const Candidate& a,const Candidate& b) {
    // A data sequence can resemble the short marker. Its arbitrary header
    // usually needs a correction, unlike a clean true header. Prefer the
    // latter across tiny IQ quantization differences in marker coherence.
    // Corrected genuine headers remain eligible and protected by validation.
    const float a_rank=a.score-0.05f*a.header_errors,b_rank=b.score-0.05f*b.header_errors;
    return a_rank>b_rank || (a_rank==b_rank &&
        (a.header_errors<b.header_errors || (a.header_errors==b.header_errors && a.start<b.start)));
}
static void indexed_retain(const Candidate& candidate,Candidate* choices,unsigned& count,
                            size_t period,unsigned neighborhood) {
    if(candidate.score<0)return;
    unsigned replace=count;
    const size_t phase=candidate.start%period;
    for(unsigned i=0;i<count;++i){
        const size_t other=choices[i].start%period;
        const size_t difference=phase>other?phase-other:other-phase;
        const size_t distance=difference<period-difference?difference:period-difference;
        if(distance<=neighborhood){if(!indexed_better(candidate,choices[i]))return;replace=i;break;}
    }
    if(replace==count){
        if(count<8)++count;
        else {if(!indexed_better(candidate,choices[7]))return;replace=7;}
    }
    choices[replace]=candidate;
    for(unsigned i=replace;i>0&&indexed_better(choices[i],choices[i-1]);--i){
        const Candidate temp=choices[i];choices[i]=choices[i-1];choices[i-1]=temp;
    }
}
class IndexedSearch {
public:
    IndexedSearch(const volatile uint32_t* x,const Profile& p,size_t hi,size_t data_count)
        : count(0),x_(x),p_(p),hi_(hi),period_(burst_sample_count(p,data_count)),visits_(0),coarse_visits_(0),context_(cfo_context(p)) {
        memset(visited_,0,sizeof visited_);
        // Exact scheduled searches do not use the hint oscillator bank. Build
        // it lazily only when a coarse/ranked pass actually requests it.
    }
    bool stopped() const { return search_stopped_||hard_stopped_; }
    bool search_stopped() const { return search_stopped_; }
    void prepare_coarse() {
        if(!allow(DecodeStage::Search))return;
        if(!hint_ready_){
            for(unsigned tone=0;tone<8;++tone){
                if(!allow(DecodeStage::Search))return;
                hint_tones_[tone]=oscillator(p_.tones_hz[tone]+p_.cfo_hint_hz,p_.sample_rate_hz);
            }
            hint_ready_=true;
        }
        // Exact refinements may have overwritten the shared Q15 bank.
        if(p_.kernel==MatchKernel::FixedQ15&&p_.samples_per_symbol<=kIndexedPhaseSamples){
            indexed_prepare_phases(hint_tones_,p_.samples_per_symbol);
            indexed_tag_phase_key(p_,p_.cfo_hint_hz);
        }
    }
    Candidate marker_coarse(size_t start) {
        Candidate candidate;candidate.start=start;
        if(!allow(DecodeStage::Search))return candidate;
        if(!hint_ready_)prepare_coarse();
        if(!hint_ready_||search_stopped_)return candidate;
        ++coarse_visits_;candidate=indexed_candidate(x_,p_,context_,start,true,hint_tones_,false,DecodeStage::Search,&hard_stopped_);
        allow(DecodeStage::Search);return candidate;
    }
    Candidate coarse(size_t start) {
        Candidate candidate;candidate.start=start;
        if(!allow(DecodeStage::Search))return candidate;
        if(!hint_ready_)prepare_coarse();
        if(!hint_ready_||search_stopped_)return candidate;
        ++coarse_visits_;candidate=indexed_candidate(x_,p_,context_,start,true,hint_tones_,true,DecodeStage::Search,&hard_stopped_);
        allow(DecodeStage::Search);return candidate;
    }
    Candidate evaluate(size_t start,DecodeStage stage=DecodeStage::Search,bool* completed=nullptr) {
        Candidate candidate;candidate.start=start;
        if(completed)*completed=false;
        if(!allow(stage))return candidate;
        if (visited_[start/32]&(1u<<(start%32))) return candidate;
        visited_[start/32]|=1u<<(start%32);++visits_;
        candidate=indexed_candidate(x_,p_,context_,start,false,nullptr,true,stage,&hard_stopped_,completed);
        allow(stage);
        indexed_retain(candidate,choices,count,period_,p_.samples_per_symbol/2);
        return candidate;
    }
    void exhaustive() { for(size_t start=0;start<=hi_&&!stopped();++start)evaluate(start); }
    bool complete() const { return visits_==hi_+1; }
    unsigned visits() const { return visits_+coarse_visits_; }
    Candidate choices[8];unsigned count;
private:
    bool allow(DecodeStage stage) {
        if(hard_stopped_)return false;
        const bool valid=decode_budget_allows(p_,stage);
        if(!valid){if(stage==DecodeStage::Search)search_stopped_=true;else hard_stopped_=true;}
        return valid;
    }
    bool search_stopped_=false,hard_stopped_=false,hint_ready_=false;
    const volatile uint32_t* x_;const Profile& p_;size_t hi_,period_;
    unsigned visits_,coarse_visits_;CfoContext context_;
    Oscillator hint_tones_[8];
    uint32_t visited_[(kMaxSamples+31)/32];
};
static bool indexed_try_candidates(const volatile uint32_t* x,size_t count,const Profile& p,
                                   size_t data_count,uint8_t* out,uint8_t* erased,
                                   const IndexedSearch& search,BurstResult& result,
                                   IndexedValidator validate,void* context,bool& found) {
    result.search_candidates=search.visits();result.header_candidates=search.count;
    result.search_budget_exhausted=search.search_stopped();
    uint8_t candidate_symbols[rs::kMaxTones],candidate_erased[rs::kMaxTones];
    if(!decode_budget_allows(p,DecodeStage::Payload)){result.budget_exhausted=true;return false;}
    for(unsigned i=0;i<search.count;++i){
        if(!decode_budget_allows(p,DecodeStage::Payload)){result.budget_exhausted=true;return false;}
        const Candidate& choice=search.choices[i];
        if(choice.score<p.min_pilot_coherence)continue;
        found=true;result.start_sample=choice.start;result.cfo_hz=choice.cfo;
        result.phase_rad=atan2f(choice.imag,choice.real);result.pilot_coherence=choice.score;
        result.repeat_index=choice.repeat_index;result.header_errors=choice.header_errors;
        result.frequency_slicer=false;
        // The faster estimator is an opt-in proposal only. Commit its output
        // after the caller's complete validator, or retry the same candidate
        // through the unchanged matched slicer before trying another header.
        if(p.indexed_frequency_slicer&&validate){
            if(!slice_indexed_frequency(x,count,p,data_count,candidate_symbols,candidate_erased,choice,result)){
                result.budget_exhausted=true;return false;
            }
            ++result.candidate_attempts;
            const bool accepted=validate(candidate_symbols,candidate_erased,result,context);
            if(!decode_budget_allows(p,DecodeStage::Payload)){result.budget_exhausted=true;return false;}
            if(accepted){
                result.frequency_slicer=true;
                memcpy(out,candidate_symbols,data_count);memcpy(erased,candidate_erased,data_count);return true;
            }
            result.frequency_fallback=true;
        }
        if(!slice_indexed_data(x,count,p,data_count,candidate_symbols,candidate_erased,choice,result)){
            result.budget_exhausted=true;return false;
        }
        ++result.candidate_attempts;
        const bool accepted=!validate||validate(candidate_symbols,candidate_erased,result,context);
        if(!decode_budget_allows(p,DecodeStage::Payload)){result.budget_exhausted=true;return false;}
        if(accepted){memcpy(out,candidate_symbols,data_count);memcpy(erased,candidate_erased,data_count);return true;}
    }
    return false;
}
Status decode_indexed_burst(const volatile uint32_t* x,size_t count,const Profile& p,
                            size_t data_count,uint8_t* out,uint8_t* erased,
                            size_t cap,BurstResult& result,IndexedValidator validate,void* context) {
    result=BurstResult();
    if(!x||!out||!erased||validate_profile(p)!=Status::Ok||p.order!=8||p.pilot_symbols!=7||
       count>kMaxSamples||(data_count!=70&&data_count!=80&&data_count!=112))return Status::Invalid;
    const size_t period=burst_sample_count(p,data_count),header=p.pilot_symbols*p.samples_per_symbol;
    if(cap<data_count||!period||count<period+p.samples_per_symbol-1)return Status::Capacity;
    if(p.indexed_alias_cursor>count/period||(p.indexed_start_hint<0&&p.indexed_alias_cursor))return Status::Invalid;
    const size_t hi=count-header;IndexedSearch search(x,p,hi,data_count);
    bool found=false;
    if(p.indexed_start_hint>=0){
        // While scheduled and phase-locked, the previous fully validated sample
        // phase predicts this header. Search the circular phase neighborhood,
        // including equivalent complete headers in the capture. Every candidate
        // still undergoes unchanged RS/CRC/session/counter/epoch validation.
        const int32_t phase=int32_t(size_t(p.indexed_start_hint)%period);
        // The scheduled bootstrap scans49-IQ windows (radius24), including
        // the N20 profile. Capping radius to one symbol would leave8-IQ gaps
        // between those windows. Keep an explicit common bounded API limit.
        const unsigned radius=p.indexed_start_radius<24u?p.indexed_start_radius:24u;
        if(p.indexed_phase_cursor>2u*radius)return Status::Invalid;
        result.next_phase_cursor=p.indexed_phase_cursor;
        result.next_alias_cursor=p.indexed_alias_cursor;
        // Finish a held exact-search alias before changing search strategies.
        const bool ranked_mode=p.indexed_ranked_fast&&p.max_cfo_error_hz<=150000.0f&&!p.indexed_alias_cursor;
        if(p.indexed_trusted_hint&&ranked_mode&&!p.indexed_phase_cursor){
            // A previously fully validated phase is normally already at the
            // correct marker. Try that complete header before spending time
            // ranking all49 nearby phases. evaluate() still estimates this
            // capture's CFO and decodes the protected copy header; the common
            // slicer and caller validator still gate every output byte.
            // A stale/weak hint leaves the original neighborhood/fallback path
            // available, with its existing monotonic budget and fresh IQ only.
            for(size_t at=size_t(phase);at<=hi&&!search.stopped();at+=period){
                search.evaluate(at);
                if(search.count&&indexed_try_candidates(x,count,p,data_count,out,erased,search,result,validate,context,found)){
                    result.fast_path=true;result.trusted_hint=true;return Status::Ok;
                }
                if(result.budget_exhausted)return Status::Budget;
            }
        }
        if(ranked_mode){
            // Cheap phase ranking uses the already learned frequency bank and
