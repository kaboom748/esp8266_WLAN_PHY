  stats={};confirmationAttempts=confirmationMisses=0;stats.phaseMin=INT32_MAX;stats.phaseMax=INT32_MIN;locked=false;havePeerClock=false;clockPpm=clockPpmQ16=0;phaseSuspects=0;
