// Once the peer has acquired the master's epoch, its RX slot has a known
// timestamp. Do not let unrelated energy start a long DSP operation before
// the expected burst. IQ_EST remains the asynchronous acquisition path.
static bool IRAM_ATTR __attribute__((noinline)) receiveScheduled(const SlotTimer::Event& event,const mb::Profile& p) {
