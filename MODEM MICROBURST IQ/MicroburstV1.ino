  if(!iqPrepare(MAX_WORDS)){++confirmationMisses;return ConfirmationCapture::Outcome::Miss;}
  // Service at long range. The final2ms are a bounded interrupt-enabled busy
  // wait, avoiding an SDK yield across the strict capture deadline.
  while(stillRunning()&&int32_t(attempt.plan.trigger-SlotTimer::counter())>int32_t(2000u*CPU_MHZ)){
    serviceSerial();yield();
  }
  while(stillRunning()&&int32_t(attempt.plan.trigger-SlotTimer::counter())>int32_t(20u*CPU_MHZ)){}
  if(!stillRunning()){++confirmationMisses;return ConfirmationCapture::Outcome::Miss;}
  if(first.session!=mac->state().session||first.gain!=manualGain||first.highFront!=rxHighFront)
    return ConfirmationCapture::Outcome::Restart;
  const bool captured=iqTrigger(attempt.plan.trigger,true);
  if(!captured){++stats.triggerFails;++confirmationMisses;return ConfirmationCapture::Outcome::Miss;}
  const uint16_t previousCounter=peerCounter;
  const bool accepted=acceptCapture(p,true,attempt.plan.expectedCounter,&attempt);
