        for (unsigned j = 0; j < t; ++j) w.denominator[j] = w.matrix[qCount + j][unknowns];
        w.denominator[t] = 1;
        memset(w.quotient, 0, sizeof(w.quotient));
        // Polynomial division by monic E. The quotient degree is <dataCount.
        for (unsigned degree = qCount; degree-- > t;) {
            if(keep_running&&!keep_running(budget_context))return false;
            const uint8_t factor = w.numerator[degree];
            const unsigned at = degree - t;
            w.quotient[at] = factor;
            for (unsigned j = 0; j <= t; ++j)
                w.numerator[at + j] ^= mul(factor, w.denominator[j]);
        }
        bool divisible = true;
        for (unsigned j = 0; j < t; ++j) divisible = divisible && !w.numerator[j];
        if (!divisible) continue;
        unsigned errors = 0;
        for (unsigned i = 0; i < codeCount; ++i) {
            if(keep_running&&!keep_running(budget_context))return false;
            w.candidate[i] = polynomial(w.quotient, dataCount, uint8_t(i + 1));
            if ((!erased || !erased[i]) && w.candidate[i] != received[i]) ++errors;
        }
        if (errors > t || 2 * errors + erasures > kParity) continue;
        if(keep_running&&!keep_running(budget_context))return false;
        memcpy(data, w.candidate, dataCount);
        corrected = errors;
        return true;
    }
    return false;
}
bool bytes_to_tones(const uint8_t* code,size_t data_size,uint8_t* tones) {
    const unsigned tonesCount=unsigned(tone_count(data_size));
    if (!code || !tones || !tonesCount) return false;
    const unsigned codeCount=unsigned(data_size+kParity);
    for (unsigned s = 0; s < tonesCount; ++s) {
        unsigned value = 0;
        for (unsigned j = 0; j < 3; ++j) {
            const unsigned bit = s * 3 + j;
            value = (value << 1) | (bit < codeCount * 8 ? ((code[bit / 8] >> (7 - bit % 8)) & 1) : 0);
        }
        tones[s] = uint8_t(value);
    }
    return true;
}
bool tones_to_bytes(const uint8_t* tones,const bool* bad_tones,size_t data_size,
                    uint8_t* code,bool* erased) {
    const unsigned tonesCount=unsigned(tone_count(data_size));
    if (!tones || !code || !erased || !tonesCount) return false;
    const unsigned codeCount=unsigned(data_size+kParity);
    const unsigned padding=tonesCount*3-codeCount*8;
    const bool lastBad = (bad_tones && bad_tones[tonesCount - 1]) || tones[tonesCount - 1] > 7;
    if (!lastBad && (tones[tonesCount - 1] & ((1u<<padding)-1u))) return false;
    memset(code, 0, codeCount); memset(erased, 0, sizeof(bool) * codeCount);
    for (unsigned s = 0; s < tonesCount; ++s) {
        const bool bad = (bad_tones && bad_tones[s]) || tones[s] > 7;
        for (unsigned j = 0; j < 3; ++j) {
            const unsigned bit = s * 3 + j;
            if (bit >= codeCount * 8) break;
            if (bad) erased[bit / 8] = true;
            else code[bit / 8] |= uint8_t(((tones[s] >> (2 - j)) & 1) << (7 - bit % 8));
        }
    }
    return true;
}
bool encode(const uint8_t data[kData],uint8_t code[kCode]) {
    return encode_block(data,kData,code);
}
bool decode(const uint8_t received[kCode],const bool erased[kCode],
            uint8_t data[kData],unsigned& corrected,unsigned& erasures) {
    return decode_block(received,erased,kData,data,corrected,erasures);
}
bool bytes_to_tones26(const uint8_t code[kCode],uint8_t tones[kTones]) {
    return bytes_to_tones(code,kData,tones);
}
bool tones_to_bytes(const uint8_t tones[kTones],const bool bad_tones[kTones],
                    uint8_t code[kCode],bool erased[kCode]) {
    return tones_to_bytes(tones,bad_tones,kData,code,erased);
}
} }
