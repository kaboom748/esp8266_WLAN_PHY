  const uint32_t ageMs=uint32_t(micros()-runStarted)/1000u;
  if(silenceDurationMs&&ageMs>=silenceAfterMs&&ageMs-silenceAfterMs<silenceDurationMs){++stats.injectTxSkipped;return;}
