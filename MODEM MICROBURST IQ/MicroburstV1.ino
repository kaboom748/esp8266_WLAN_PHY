    // Include the remaining setup lead: check age at the scheduled RF edge,
    // not merely at foreground entry. Deadline and run age are <2^31.
    const uint32_t observedAge=micros()-lastGoodAt;
    const int32_t until=int32_t(event.deadline-SlotTimer::counter());
    const uint32_t age=observedAge+(until>0?(uint32_t(until)+CPU_MHZ-1u)/CPU_MHZ:0u);
