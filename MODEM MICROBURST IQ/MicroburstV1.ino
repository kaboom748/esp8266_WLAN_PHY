// RREF for a bounded, possibly overdetermined system. Require a UNIQUE solution
// and reject every inconsistent row, rather than trusting the first square set.
bool solve(unsigned rows,unsigned columns,ContinueWork keep_running,void* budget_context,
           bool& cancelled) {
    Workspace& w = workspace;
    unsigned pivotRow = 0;
    for (unsigned column = 0; column < columns; ++column) {
        if(keep_running&&!keep_running(budget_context)){cancelled=true;return false;}
        unsigned selected = pivotRow;
        while (selected < rows && !w.matrix[selected][column]) ++selected;
        if (selected == rows) return false;
        if (selected != pivotRow)
            for (unsigned j = 0; j <= columns; ++j) {
                const uint8_t value = w.matrix[selected][j];
                w.matrix[selected][j] = w.matrix[pivotRow][j];
                w.matrix[pivotRow][j] = value;
            }
        const uint8_t inv = inverse(w.matrix[pivotRow][column]);
        for (unsigned j = column; j <= columns; ++j)
            w.matrix[pivotRow][j] = mul(w.matrix[pivotRow][j], inv);
        for (unsigned i = 0; i < rows; ++i) {
            if(keep_running&&!keep_running(budget_context)){cancelled=true;return false;}
            if (i == pivotRow || !w.matrix[i][column]) continue;
            const uint8_t factor = w.matrix[i][column];
            for (unsigned j = column; j <= columns; ++j)
                w.matrix[i][j] ^= mul(factor, w.matrix[pivotRow][j]);
        }
        ++pivotRow;
    }
    for (unsigned row = pivotRow; row < rows; ++row) {
        bool zero = true;
        for (unsigned column = 0; column < columns; ++column)
            zero = zero && !w.matrix[row][column];
        if (zero && w.matrix[row][columns]) return false;
