static bool selectFrame(mb::Frame& frame) {
  if(autonomousSessionRecovery){
    // A cold slave cannot learn a session from SYNC. Reannounce when peer
    // absence is established; healthy traffic keeps all its DATA slots.
    if(linkLost||!mac->state().joined)SessionRecovery::serviceMaster(*mac,sessionRecovery,micros());
    if(role==1&&mac->state().joining&&mac->poll(micros(),frame)){
      ownTurn=false;return true;
    }
  }
  if(linkLost&&mac->state().joined&&mac->state().session_known){frame=mb::Frame();frame.type=mb::FrameType::Sync;frame.session=mac->state().session;return true;}
  queueStream();
  // V5: every pending response competes fairly with eligible local traffic.
  // Continuous new ACKs must not starve the other direction's DATA. Keep a
  // deferred reply intact, and serve it on the next local slot after DATA.
  if(haveResponse){
    if(response->type==mb::FrameType::Ack&&(role==1||peerConfirmed)&&mac->poll(micros(),frame)){haveResponse=false;ownTurn=false;return true;}
    if(ownTurn&&(role==1||peerConfirmed)&&mac->poll(micros(),frame)){ownTurn=false;return true;}
    noteExhaustion();frame=*response;haveResponse=false;ownTurn=true;return true;
  }
  if((role==1||peerConfirmed)&&mac->poll(micros(),frame)){ownTurn=false;return true;}
  noteExhaustion();
