  // initial JOIN in bounded batches until answered or this TDD run ends. This
  // path is forbidden with pending DATA: its retry exhaustion is preserved.
  const auto& state=mac->state();
  if(role==1&&!state.joined&&!state.pending&&state.session_known&&state.exhausted&&
     mac->rejoin(micros())==mb::Status::Ok){
    ++stats.joinRetryBatches;
    if(mac->poll(micros(),frame)){ownTurn=false;return true;}
  }
  // Clock maintenance is independent of JOIN/DATA retry exhaustion. A neutral
  // SYNC cannot deliver payload, acknowledge data, or restart MAC attempts.
  if(mac->state().joined&&mac->state().session_known){frame=mb::Frame();frame.type=mb::FrameType::Sync;frame.session=mac->state().session;return true;}
  return false;
}
static void transmitSlot(const SlotTimer::Event& event,const mb::Profile& p,unsigned kstep,unsigned cycles) {
