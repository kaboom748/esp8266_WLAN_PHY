static ConfirmationCapture::Outcome receiveConfirmation(const mb::Profile& p,ConfirmationCapture::Attempt& attempt) {
  // Predicted confirmation targets the HW-AGC path. Other acquisition
  // modes retain the existing independent Barker path without new policy.
  if(role!=2||locked||!recoveryState.haveAnchor||!rxHardwareAgc||agcIsEnabled())return ConfirmationCapture::Outcome::Unavailable;
  const auto first=recoveryState.anchor;
  if(first.session!=mac->state().session||first.gain!=manualGain||first.highFront!=rxHighFront)
    return ConfirmationCapture::Outcome::Restart;
  ConfirmationCapture::Geometry geometry;geometry.cpu=CPU_MHZ;geometry.halfCycles=nominalHalfCycles;
  geometry.repeatCycles=repeatPeriodCycles;geometry.copies=txCopies;
  geometry.preambleGapCycles=(preambleUs+gapUs)*CPU_MHZ+txBurstStartLeadCycles;
  geometry.advanceCycles=triggerAdvanceSamples*4u;
